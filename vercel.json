{
  "builds": [
    {
      "src": "exam_platform/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput"
      }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "exam_platform/wsgi.py" },
    { "src": "/(.*)", "dest": "exam_platform/wsgi.py" }
  ]
}